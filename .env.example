# Copy to .env for local development when a phase requires environment variables.
# Never commit real credentials.

APP_ENV=local
LOG_LEVEL=INFO

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# KServe / Kubernetes
KUBERNETES_NAMESPACE=mini-mip

# LiteLLM
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=replace-me
